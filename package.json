{
  "name": "orbit",
  "version": "1.0.0",
  "private": true,
  "description": "ORBIT — Autonomous Astronaut Health Intelligence & Mission Simulation",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm --workspace client run build",
    "build:server": "npm --workspace server run build",
    "preview": "npm --workspace client run preview",
    "start": "npm --workspace server run start",
    "test": "npm --workspace client run test",
    "test:e2e": "npm --workspace client run test:e2e",
    "typecheck": "npm --workspace client run typecheck && npm --workspace server run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
